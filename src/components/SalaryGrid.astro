---
---
<div class="bg-gray-50 rounded-xl w-full min-w-0">
  <!-- Main Content Section -->
  <div class="py-6 md:py-8 lg:py-10 px-3 sm:px-4 lg:px-6 xl:px-8 w-full min-w-0">
      <div class="mx-auto w-full max-w-6xl xl:max-w-7xl">
          <!-- Header Text -->
          <div class="text-center mb-6 md:mb-8 lg:mb-10">
              <p class="mt-2 max-w-2xl mx-auto text-sm md:text-base lg:text-lg xl:text-xl text-wood-dark leading-relaxed">
                  At OIAC, we believe in investing in exceptional educators who are <span class="text-gray-950 font-semibold">Alberta Certified</span>. Our competitive compensation package reflects our commitment to attracting and retaining outstanding teachers who share our vision for educational excellence in Edmonton's Islamic community.
              </p>
          </div>

          <!-- Salary Grid Image -->
          <div class="w-full flex justify-center">
            <img
              src="/images/Salary-Grid-1.png"
              alt="OIA Academy Salary Grid 2026-2027"
              class="w-full max-w-3xl rounded-lg shadow-md"
            />
          </div>
      </div>
  </div>

  <!-- Benefits Section -->
  <div class="mt-8 md:mt-12 lg:mt-16 xl:mt-20 w-full px-3 sm:px-4 lg:px-6 xl:px-8 pb-6 md:pb-8 lg:pb-10">
      <div class="mx-auto w-full max-w-6xl xl:max-w-7xl">
          <h2 class="text-lg md:text-xl lg:text-2xl xl:text-3xl font-extrabold text-terracottaRed-darker tracking-tight text-center mb-6 md:mb-8 lg:mb-10">
              Comprehensive Benefits Package
          </h2>
          <div class="grid gap-5 md:gap-6 lg:gap-8 grid-cols-1 xl:grid-cols-2 w-full min-w-0">
              <!-- Health Benefits -->
              <div class="bg-white rounded-lg shadow-lg p-4 md:p-5 lg:p-6 xl:p-8 flex flex-col h-full">
                  <h3 class="text-base md:text-lg lg:text-xl font-bold text-wood-dark mb-3 md:mb-4 lg:mb-6">Health Benefits Snapshot</h3>
                  <ul class="space-y-2 md:space-y-3 lg:space-y-4 text-gray-700 text-xs md:text-sm lg:text-base">
                      <li class="flex items-start">
                          <span class="text-terracottaRed-darker mr-2 mt-1 flex-shrink-0">•</span>
                          <div class="min-w-0">
                              <span class="font-semibold">Paramedical Services:</span><br/>
                              <span class="text-xs md:text-sm text-gray-600 leading-relaxed">Chiropractor, Osteopath, Naturopath, Psychologist, Dietitian, Massage Therapist, Acupuncture</span>
                          </div>
                      </li>
                      <li class="flex items-center">
                          <span class="text-terracottaRed-darker mr-2 flex-shrink-0">•</span>
                          <span class="font-semibold">Vision Care</span>
                      </li>
                      <li class="flex items-center">
                          <span class="text-terracottaRed-darker mr-2 flex-shrink-0">•</span>
                          <span class="font-semibold">Prescription Drugs</span>
                      </li>
                      <li class="flex items-center">
                          <span class="text-terracottaRed-darker mr-2 flex-shrink-0">•</span>
                          <span class="font-semibold">Hearing and Speech Aids</span>
                      </li>
                      <li class="flex items-center">
                          <span class="text-terracottaRed-darker mr-2 flex-shrink-0">•</span>
                          <span class="font-semibold">Orthopedics</span>
                      </li>
                      <li class="flex items-start">
                          <span class="text-terracottaRed-darker mr-2 mt-1 flex-shrink-0">•</span>
                          <div class="min-w-0">
                              <span class="font-semibold">Dental Care:</span><br/>
                              <span class="text-xs md:text-sm text-gray-600">Basic, Major Dental, Accidental</span>
                          </div>
                      </li>
                      <li class="flex items-start">
                          <span class="text-terracottaRed-darker mr-2 mt-1 flex-shrink-0">•</span>
                          <div class="min-w-0">
                              <span class="font-semibold">Long Term Disability:</span><br/>
                              <span class="text-xs md:text-sm text-gray-600 leading-relaxed">Your well-being is protected with coverage through OIAC's long-term disability plan.</span>
                          </div>
                      </li>
                  </ul>
              </div>

              <!-- Pension Plan -->
              <div class="bg-white rounded-lg shadow-lg p-4 md:p-5 lg:p-6 xl:p-8 flex flex-col h-full">
                  <h3 class="text-base md:text-lg lg:text-xl font-bold text-wood-dark mb-3 md:mb-4 lg:mb-6">Pension Plan Snapshot</h3>
                  <div class="space-y-2 md:space-y-3 lg:space-y-4 text-gray-700 text-xs md:text-sm lg:text-base">
                      <p class="leading-relaxed">
                          OIAC has a deferred contribution pension plan where an amount of money, based on your earning, is credited to an account in your name. OIAC will match that employee contribution. The employee manages the growth of the plan.
                      </p>
                      <p class="leading-relaxed">
                          Full-time and part-time employees are eligible to join the plan upon successful completion of 1 year of continuous employment with OIAC.
                      </p>
                      <p class="leading-relaxed">
                          Member contribution level is consistent with number of years served at OIAC.
                      </p>
                  </div>
              </div>
          </div>
      </div>
  </div>
</div>